---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layouts.astro'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="My Blog">
  <div class="divide-y divide-slate-100">
    {posts.map((post) => (
      <article class="py-8 first:pt-0">
        <a href={`${base}/page/${post.id}/`} class="group block">
          <h2 class="text-2xl font-bold text-slate-900 group-hover:text-orange-600 transition-colors">
            {post.data.title}
          </h2>
          {post.data.description && (
            <p class="mt-2 text-slate-600 leading-relaxed">{post.data.description}</p>
          )}
          <time class="mt-3 block text-xs uppercase tracking-wider text-slate-400">
            {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
          </time>
        </a>
      </article>
    ))}
  </div>
</Layout>
